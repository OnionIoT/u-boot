# Boot options
bootcmd=sf probe && mtd read firmware 81800000 0 400000 && bootm 81800000
bootargs=console=ttyS0,115200 rootfstype=squashfs,jffs2
bootfile=firmware.bin
bootmenu_0=Boot Omega2=run bootcmd
bootmenu_1=Start Web recovery mode=echo "Web recovery not implemented yet"
bootmenu_2=Flash firmware from USB storage=echo "Firmware flashing not implemented yet"

# By default, boot immediately. Pressing the reset button changes this value (see board file).
bootdelay=0

# Network configuration
serverip=192.168.8.100
ipaddr=192.168.8.8
loadaddr=0x81800000

# MTD settings
mtdids=nor0=spi0.0
mtdparts=spi0.0:192k(u-boot),64k(u-boot-env),64k(factory),32448k(firmware)
